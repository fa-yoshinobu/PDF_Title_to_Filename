<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PdfTitleRenamer.Views.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:PdfTitleRenamer.Helpers"
        Title="PDF Title to Filename" Height="680" Width="960"
        MinHeight="520" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI"
        FontSize="13"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave">

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding SelectFilesCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ProcessFilesCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshPreviewCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
    </Window.InputBindings>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="160"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="LogRow" Height="150" MinHeight="70"/>
        </Grid.RowDefinitions>

        <!-- ===== ツールバー ===== -->
        <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True">
                    <!-- 右側: 言語・設定・情報 -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding ChangeLanguageCommand}"
                                CommandParameter="{Binding NextLanguageCode}"
                                ToolTip="{Binding LanguageToolTip}"
                                AutomationProperties.Name="{Binding LanguageToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE774;" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding LanguageButtonText}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                                Content="&#xE713;"
                                Command="{Binding ShowSettingsCommand}"
                                ToolTip="{Binding SettingsToolTip}"
                                AutomationProperties.Name="{Binding SettingsToolTip}"/>
                        <Button Style="{StaticResource IconButton}"
                                Content="&#xE946;"
                                Command="{Binding ShowAboutCommand}"
                                ToolTip="{Binding AboutToolTip}"
                                AutomationProperties.Name="{Binding AboutToolTip}"/>
                    </StackPanel>

                    <!-- 左側: 主な操作（狭いウィンドウでは折り返す） -->
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding SelectFilesCommand}"
                                ToolTip="{Binding FileSelectionToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding FileSelectionText}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MainButton}"
                                Command="{Binding ProcessFilesCommand}"
                                ToolTip="{Binding ProcessStartToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE768;" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ProcessStartText}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding UndoCommand}"
                                ToolTip="{Binding UndoToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE7A7;" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding UndoText}"/>
                            </StackPanel>
                        </Button>

                        <Rectangle Width="1" Height="22" Margin="6,0" Fill="{StaticResource LineStrongBrush}" VerticalAlignment="Center"/>

                        <Button Style="{StaticResource WarningButton}"
                                Command="{Binding RemoveNoMetadataFilesCommand}"
                                ToolTip="{Binding RemoveNoMetadataToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE71C;" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding RemoveNoMetadataText}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource DangerButton}"
                                Command="{Binding ClearFilesCommand}"
                                ToolTip="{Binding ClearListToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ClearListText}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </DockPanel>

                <!-- 進捗 -->
                <Grid Grid.Row="1" Margin="4,8,4,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8A5;" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding FileCountText}" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    </StackPanel>
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding ProgressText}" FontSize="12"
                                   Foreground="{StaticResource TextBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,3"
                                   ToolTip="{Binding ProgressText}"/>
                        <ProgressBar Grid.Row="1" Value="{Binding ProgressValue}" Maximum="100" Height="6"
                                     BorderThickness="0"
                                     Background="{StaticResource LineBrush}"
                                     Foreground="{StaticResource AccentBrush}"/>
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{Binding ProgressValue, StringFormat='{}{0:F0}%'}"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               MinWidth="38" TextAlignment="Right" VerticalAlignment="Bottom" Margin="8,0,0,-2"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== ファイル一覧 ===== -->
        <Border Grid.Row="1" Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ステータスの件数と絞り込み -->
                <WrapPanel x:Name="FilterBar" Grid.Row="0" Margin="2,0,0,8">
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="StatusFilter"
                                 IsChecked="{Binding IsFilterAll, Mode=TwoWay}" Content="{Binding FilterAllText}"/>
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="StatusFilter"
                                 IsChecked="{Binding IsFilterScheduled, Mode=TwoWay}" Content="{Binding FilterScheduledText}"/>
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="StatusFilter"
                                 IsChecked="{Binding IsFilterNoMetadata, Mode=TwoWay}" Content="{Binding FilterNoMetadataText}"/>
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="StatusFilter"
                                 IsChecked="{Binding IsFilterError, Mode=TwoWay}" Content="{Binding FilterErrorText}"/>
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="StatusFilter"
                                 IsChecked="{Binding IsFilterDone, Mode=TwoWay}" Content="{Binding FilterDoneText}"/>
                </WrapPanel>

                <!-- 空のときのドロップ領域（クリックでファイル選択） -->
                <Grid x:Name="EmptyDropZone" Grid.Row="0" Grid.RowSpan="2"
                      Background="{StaticResource SurfaceAltBrush}"
                      Cursor="Hand"
                      MouseLeftButtonUp="EmptyDropZone_MouseLeftButtonUp">
                    <Rectangle Stroke="{StaticResource LineStrongBrush}" StrokeThickness="1.5"
                               StrokeDashArray="5 3" RadiusX="8" RadiusY="8"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8A5;" FontSize="44"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                        <TextBlock Text="{Binding DragDropFilesText}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock Text="{Binding DragDropSubText}" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <TextBlock Text="{Binding OrText}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ClickToSelectText}" Foreground="{StaticResource AccentBrush}"
                                       FontSize="12" FontWeight="SemiBold" TextDecorations="Underline"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <DataGrid x:Name="FileDataGrid" Grid.Row="1"
                          ItemsSource="{Binding SelectedFiles}"
                          AutoGenerateColumns="False"
                          Background="{StaticResource SurfaceBrush}"
                          Foreground="{StaticResource TextBrush}"
                          BorderBrush="{StaticResource LineBrush}"
                          BorderThickness="1"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource LineBrush}"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          RowBackground="{StaticResource SurfaceBrush}"
                          AlternatingRowBackground="{StaticResource SurfaceAltBrush}"
                          MinRowHeight="34"
                          RowDetailsVisibilityMode="VisibleWhenSelected"
                          BeginningEdit="FileDataGrid_BeginningEdit">
                    <DataGrid.Resources>
                        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}"/>
                    </DataGrid.Resources>

                    <DataGrid.InputBindings>
                        <KeyBinding Key="Delete"
                                    Command="{Binding RemoveSelectedCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=FileDataGrid}"/>
                    </DataGrid.InputBindings>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{Binding ContextOpenFileText}"
                                      Command="{Binding OpenFileCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon>
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{Binding ContextOpenFolderText}"
                                      Command="{Binding OpenFolderCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon>
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8B7;"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{Binding ContextCopyNewNameText}"
                                      Command="{Binding CopyNewNameCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon>
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="{Binding ContextRemoveFromListText}"
                                      Command="{Binding RemoveSelectedCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon>
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE711;"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="8,7"/>
                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <!-- 選択時にシステムの濃い青＋白文字にならないよう、セルは透過にして行の色を見せる -->
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <!-- 選択した行の下にエラーなどの詳細を表示 -->
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ErrorDetails}"
                                       Margin="44,0,12,8"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasErrorDetails}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{Binding Data.OperationHeader, Source={StaticResource Proxy}}"
                                                Width="SizeToHeader" MinWidth="44" CanUserSort="False" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowIconButton}"
                                            Content="&#xE711;"
                                            Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding DataContext.DeleteToolTip, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            AutomationProperties.Name="{Binding DataContext.DeleteToolTip, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="{Binding Data.CurrentNameHeader, Source={StaticResource Proxy}}"
                                            Binding="{Binding FileName}"
                                            Width="2*"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                    <Setter Property="ToolTip" Value="{Binding FilePath}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 新しい名前: ダブルクリック / F2 で手修正できる -->
                        <DataGridTemplateColumn Header="{Binding Data.NewNameHeader, Source={StaticResource Proxy}}"
                                                Width="3*"
                                                SortMemberPath="NewFileNameDisplay">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="8,7"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="ToolTip" Value="{Binding DataContext.NewNameEditToolTip, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="8,6" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE70F;" FontSize="11"
                                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,5,0"
                                                   ToolTip="{Binding DataContext.ManuallyEditedText, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <TextBlock.Visibility>
                                                <Binding Path="IsManuallyEdited">
                                                    <Binding.Converter>
                                                        <BooleanToVisibilityConverter/>
                                                    </Binding.Converter>
                                                </Binding>
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                        <TextBlock Text="{Binding NewFileNameDisplay}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding NewFileNameDisplay}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding EditableFileName, UpdateSourceTrigger=LostFocus}"
                                             Padding="4,3" Margin="4,2"
                                             VerticalContentAlignment="Center"
                                             BorderBrush="{StaticResource AccentBrush}"
                                             Loaded="EditTextBox_Loaded"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{Binding Data.StatusHeader, Source={StaticResource Proxy}}"
                                                Width="Auto" MinWidth="150"
                                                SortMemberPath="StatusDisplay">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0"
                                                ToolTip="{Binding ErrorDetails}">
                                        <TextBlock x:Name="StatusIcon" Style="{StaticResource IconText}" FontSize="13"
                                                   Margin="0,0,6,0" Text="&#xE823;" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="StatusLabel" Text="{Binding StatusDisplay}"
                                                   VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Error">
                                            <Setter TargetName="StatusIcon" Property="Text" Value="&#xE783;"/>
                                            <Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                            <Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                            <Setter TargetName="StatusLabel" Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="NoTitle">
                                            <Setter TargetName="StatusIcon" Property="Text" Value="&#xE7BA;"/>
                                            <Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                            <Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                            <Setter TargetName="StatusLabel" Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="NoMetadata">
                                            <Setter TargetName="StatusIcon" Property="Text" Value="&#xE7BA;"/>
                                            <Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                            <Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                            <Setter TargetName="StatusLabel" Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="RenameComplete">
                                            <Setter TargetName="StatusIcon" Property="Text" Value="&#xE73E;"/>
                                            <Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            <Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            <Setter TargetName="StatusLabel" Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="RenameScheduled">
                                            <Setter TargetName="StatusIcon" Property="Text" Value="&#xE8AC;"/>
                                            <Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource AccentStrongBrush}"/>
                                            <Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource AccentStrongBrush}"/>
                                            <Setter TargetName="StatusLabel" Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Processing">
                                            <Setter TargetName="StatusIcon" Property="Text" Value="&#xE895;"/>
                                            <Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource ProcessingBrush}"/>
                                            <Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource ProcessingBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="NoChangeNeeded">
                                            <Setter TargetName="StatusIcon" Property="Text" Value="&#xE946;"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- ドラッグ中のハイライト -->
                <Border x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="2"
                        Background="#142563EB"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="16,10"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE896;" FontSize="16"
                                       Foreground="{StaticResource AccentStrongBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding DragDropOverlayText}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentStrongBrush}"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <!-- ===== 一覧とログの境目（ドラッグで高さ変更） ===== -->
        <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Background="Transparent" Cursor="SizeNS" Focusable="False">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <Rectangle Width="40" Height="3" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{StaticResource LineStrongBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- ===== ログ ===== -->
        <Border Grid.Row="3" Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="2,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                            Width="28" Height="28" Margin="0" FontSize="13"
                            Content="&#xE74D;"
                            Command="{Binding ClearLogCommand}"
                            ToolTip="{Binding ClearLogToolTip}"
                            AutomationProperties.Name="{Binding ClearLogToolTip}"/>
                    <TextBlock Text="{Binding ProcessingLogText}" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <TextBox x:Name="LogTextBox" Grid.Row="1"
                         Text="{Binding LogText, Mode=OneWay}"
                         IsReadOnly="True"
                         Background="{StaticResource SurfaceAltBrush}"
                         Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource LineBrush}"
                         BorderThickness="1"
                         Padding="8"
                         FontFamily="Cascadia Mono, Consolas, MS Gothic"
                         FontSize="11.5"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         TextChanged="LogTextBox_TextChanged"/>
            </Grid>
        </Border>
    </Grid>
</Window>
